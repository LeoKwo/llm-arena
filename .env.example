# Copy to .env and fill in your keys.
# Loaded automatically (python-dotenv) by agent/llm_factory.py.
# Real shell environment variables take precedence over values in this file.

# ---- API keys ----
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# ---- Chat models: global default + per-nation overrides ----
# Providers: ollama | zhipu | deepseek | qwen | kimi
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=qwen3.5:latest

# Optional per-nation overrides (leave blank to use the global default)
GERMANY_PROVIDER=
GERMANY_MODEL=
FRANCE_PROVIDER=
FRANCE_MODEL=
UK_PROVIDER=
UK_MODEL=

# ---- Embedding model (used for agent memory / FAISS) ----
# DeepSeek has no embeddings API, so the default is Zhipu embedding-3.
# For a free local embedding model, set EMBEDDING_PROVIDER=ollama.
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-3
# Optional overrides for a custom OpenAI-compatible embeddings endpoint:
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
