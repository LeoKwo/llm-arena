# Copy to .env and fill in your keys.
# Loaded automatically (python-dotenv) by agent/llm_factory.py.
# Real shell environment variables take precedence over values in this file.

# ---- API keys ----
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# ---- Chat models: global default + per-nation overrides ----
# Providers: ollama | zhipu | deepseek | qwen | kimi
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=qwen3.5:latest

# Optional per-nation overrides (leave blank to use the global default)
GERMANY_PROVIDER=
GERMANY_MODEL=
FRANCE_PROVIDER=
FRANCE_MODEL=
UK_PROVIDER=
UK_MODEL=
USSR_PROVIDER=
USSR_MODEL=

# ---- Embedding model (used for agent memory / FAISS) ----
# DeepSeek has no embeddings API, so the default is Zhipu embedding-3.
# For a free local embedding model, set EMBEDDING_PROVIDER=ollama.
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-3
# Optional overrides for a custom OpenAI-compatible embeddings endpoint.
# Use the BASE url without the trailing /embeddings
# (e.g. https://open.bigmodel.cn/api/paas/v4).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ---- Map ----
# Optional fixed seed for reproducible terrain/resource layout.
MAP_SEED=

# ---- Game mechanics tuning ----
# Fraction of the loser's strength the winner loses in combat (0~1)
ATTACK_ATTRITION=0.3
# Fraction of a captured city's resources looted by the attacker (0~1)
CITY_LOOT_RATE=0.3
# Resources each unit costs per turn (paid by your cities)
UPKEEP_PER_UNIT=1
# Max hex distance for supplying a unit from a city
SUPPLY_RANGE=3
# Relation points that decay toward 0 each round
RELATION_DECAY=3
# Goal completion weighting: score = resources * (1 + GOAL_SCORE_BONUS * completion)
GOAL_SCORE_BONUS=0.5

# ---- Territory & capitals ----
# Score added per city / per controlled tile
CITY_SCORE=50
TILE_SCORE=5
# A tile is controlled only while a unit with at least this many resources stands on it
OCCUPATION_MIN_RESOURCES=5
# Capitals cannot be annexed during the first N rounds
CAPITAL_ANNEX_PROTECT_TURNS=2
# Rounds a captured capital must be held before annexation
CAPITAL_HOLD_ROUNDS=1
# Fraction of each annexed city's resources kept when sovereignty transfers
ANNEX_CITY_KEEP=0.75

# ---- Forced march ----
# Cost of the 1st extra tile; each further tile multiplies by EXTRA_MOVE_GROWTH
EXTRA_MOVE_BASE=4
EXTRA_MOVE_GROWTH=2
# Max extra tiles per unit per turn
MAX_FORCED_MARCH=5
# Resources a unit must keep after a forced march
MIN_FORCED_MARCH_RESERVE=1
